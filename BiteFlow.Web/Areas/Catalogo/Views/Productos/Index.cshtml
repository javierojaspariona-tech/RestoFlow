@model IReadOnlyList<Producto>
@{
    ViewData["Title"] = "Catálogo";
    var categorias = (IReadOnlyList<Categoria>)ViewBag.Categorias;
    var idCategoria = (int?)ViewBag.IdCategoria;
}

<h1 class="h3 mb-3">Catálogo de productos</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="idCategoria" class="form-select" onchange="this.form.submit()">
            <option value="">Todas las categorías</option>
            @foreach (var categoria in categorias)
            {
                <option value="@categoria.IdCategoria" selected="@(idCategoria == categoria.IdCategoria)">@categoria.Nombre</option>
            }
        </select>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">No hay productos disponibles.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Categoría</th>
                <th>Producto</th>
                <th>Descripción</th>
                <th class="text-end">Precio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.Categoria.Nombre</td>
                    <td>@producto.Nombre</td>
                    <td>@producto.Descripcion</td>
                    <td class="text-end">S/ @producto.Precio.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}
