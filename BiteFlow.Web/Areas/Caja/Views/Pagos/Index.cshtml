@model IReadOnlyList<Pedido>
@{
    ViewData["Title"] = "Caja";
}

<h1 class="h3 mb-3">Pedidos pendientes de pago</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay pedidos pendientes de pago.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>N.º pedido</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in Model)
            {
                <tr>
                    <td>@pedido.IdPedido</td>
                    <td>@pedido.Cliente.NombreCompleto</td>
                    <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">S/ @pedido.Total.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}
