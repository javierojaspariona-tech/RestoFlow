@model IReadOnlyList<CarritoItem>
@{
    ViewData["Title"] = "Carrito";
    var total = (decimal)ViewBag.Total;
}

<h1 class="h3 mb-3">Mi carrito</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Tu carrito está vacío.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th class="text-end">Precio</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td class="text-end">S/ @item.PrecioUnitario.ToString("N2")</td>
                    <td class="text-end">@item.Cantidad</td>
                    <td class="text-end">S/ @item.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end">S/ @total.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>
}
