@model IReadOnlyList<Usuario>
@{ ViewData["Title"]="Usuarios"; }
<h1 class="h3 fw-bold mb-3">Usuarios del sistema</h1><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var u in Model){<tr><td>@u.Nombres @u.Apellidos</td><td>@u.Correo</td><td>@u.Rol?.Nombre</td><td>@(u.Activo?"Activo":"Inactivo")</td><td><form asp-action="CambiarEstado" method="post"><input type="hidden" name="id" value="@u.IdUsuario"/><button class="btn btn-sm btn-outline-secondary">@(u.Activo?"Desactivar":"Activar")</button></form></td></tr>}
</tbody></table></div>
