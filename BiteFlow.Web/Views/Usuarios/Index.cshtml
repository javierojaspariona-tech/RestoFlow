@model IReadOnlyList<Usuario>
@{ ViewData["Title"] = "Usuarios"; }

<div class="page-head">
    <div>
        <h1 class="page-title">Usuarios del sistema</h1>
        <p class="page-sub">Activa o desactiva el acceso de cada cuenta.</p>
    </div>
</div>

<div class="table-wrap table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-semibold">@u.Nombres @u.Apellidos</td>
                    <td>@u.Correo</td>
                    <td><span class="pill">@u.Rol?.Nombre</span></td>
                    <td><span class="pill @(u.Activo ? "pill-yes" : "pill-no")">@(u.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end">
                        <form asp-action="CambiarEstado" method="post" class="m-0">
                            <input type="hidden" name="id" value="@u.IdUsuario" />
                            <button class="btn btn-sm @(u.Activo ? "btn-line-danger" : "btn-line")">@(u.Activo ? "Desactivar" : "Activar")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
