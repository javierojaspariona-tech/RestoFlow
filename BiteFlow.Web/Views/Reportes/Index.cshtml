@model PaginaResultado<ReporteVentaDto>
@{ ViewData["Title"] = "Reportes de ventas"; }

<div class="page-head">
    <div>
        <h1 class="page-title">Reporte de ventas</h1>
        <p class="page-sub">Filtra los pagos registrados por fecha.</p>
    </div>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="inicio">Desde</label>
            <input type="date" id="inicio" name="inicio" value="@ViewBag.Inicio" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="fin">Hasta</label>
            <input type="date" id="fin" name="fin" value="@ViewBag.Fin" class="form-control" />
        </div>
        <div class="col-md-4"><button class="btn btn-brand w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button></div>
    </div>
</form>

<div class="table-wrap table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Fecha</th><th>Pedido</th><th>Comprobante</th><th>Cajero</th><th>Método</th><th class="text-end">Monto</th></tr></thead>
        <tbody>
            @foreach (var v in Model.Items)
            {
                <tr>
                    <td>@v.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="fw-semibold">@v.CodigoPedido</td>
                    <td>@v.NumeroComprobante</td>
                    <td>@v.Cajero</td>
                    <td><span class="pill">@v.MetodoPago</span></td>
                    <td class="text-end fw-semibold">S/ @v.Monto.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <span class="text-secondary small">@Model.TotalRegistros registros · Página @Model.Pagina de @Math.Max(1, Model.TotalPaginas)</span>
    <div class="d-flex gap-2">
        @if (Model.Pagina > 1)
        {
            <a class="btn btn-sm btn-line" href="?inicio=@ViewBag.Inicio&fin=@ViewBag.Fin&pagina=@(Model.Pagina - 1)">Anterior</a>
        }
        @if (Model.Pagina < Model.TotalPaginas)
        {
            <a class="btn btn-sm btn-line" href="?inicio=@ViewBag.Inicio&fin=@ViewBag.Fin&pagina=@(Model.Pagina + 1)">Siguiente</a>
        }
    </div>
</div>
