@model List<CarritoItem>
@{ ViewData["Title"]="Carrito"; var total=Model.Sum(x=>x.Importe); }
<h1 class="h3 fw-bold mb-3">Tu carrito</h1>
@if(Model.Count==0){<div class="alert alert-info">Tu carrito está vacío. <a asp-controller="Home" asp-action="Index">Volver a la carta</a>.</div>}
else{
<div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Importe</th><th></th></tr></thead><tbody>
@foreach(var i in Model){<tr><td>@i.Nombre</td><td>S/ @i.Precio.ToString("0.00")</td><td><form asp-action="Cantidad" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@i.IdProducto"/><input type="number" name="cantidad" value="@i.Cantidad" min="0" max="99" class="form-control form-control-sm" style="width:85px"/><button class="btn btn-sm btn-outline-secondary">Actualizar</button></form></td><td>S/ @i.Importe.ToString("0.00")</td><td><form asp-action="Quitar" method="post"><input type="hidden" name="id" value="@i.IdProducto"/><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr>}
</tbody></table></div>
<div class="row justify-content-end mt-3"><div class="col-md-5 col-lg-4"><div class="card card-body"><div class="d-flex justify-content-between"><span>Total (IGV incluido)</span><strong class="fs-4">S/ @total.ToString("0.00")</strong></div>
@if(User.Identity?.IsAuthenticated==true && User.IsInRole(Roles.Cliente)){
<form asp-controller="Pedidos" asp-action="Confirmar" method="post" class="mt-3"><label class="form-label">Modalidad</label><select name="Modalidad" id="modalidad" class="form-select mb-2" onchange="document.getElementById('mesaBox').hidden=this.value!=='Mesa'"><option value="ParaLlevar">Para llevar</option><option value="Mesa">En mesa</option></select><div id="mesaBox" hidden class="mb-2"><label class="form-label">Número de mesa</label><input name="NumeroMesa" type="number" min="1" max="99" class="form-control"/></div><label class="form-label">Observación</label><textarea name="Observacion" class="form-control mb-3"></textarea><button class="btn btn-warning w-100">Confirmar pedido</button></form>
}else{<a asp-controller="Account" asp-action="Login" class="btn btn-warning w-100 mt-3">Inicia sesión para confirmar</a>}
</div></div></div>
}
