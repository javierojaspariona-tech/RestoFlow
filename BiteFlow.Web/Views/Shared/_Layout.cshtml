<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiteFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bf-nav sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><i class="bi bi-cup-hot-fill text-warning me-2"></i>Bite<span class="text-warning">Flow</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Carta</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Carrito" asp-action="Index"><i class="bi bi-cart3"></i> Carrito</a></li>
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Cliente))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Pedidos" asp-action="MisPedidos">Mis pedidos</a></li>
                }
                @if (User.IsInRole(Roles.Administrador))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Administración</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Admin">Panel</a></li>
                            <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index">Productos</a></li>
                            <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                            <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Index">Reportes</a></li>
                            <li><a class="dropdown-item" asp-controller="Pagos" asp-action="Index">Caja</a></li>
                        </ul>
                    </li>
                }
                @if (User.IsInRole(Roles.Cajero))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Pagos" asp-action="Index">Caja</a></li>
                }
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-light small d-none d-md-inline">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Salir</button></form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Ingresar</a>
                    <a class="btn btn-sm btn-warning" asp-controller="Account" asp-action="Register">Crear cuenta</a>
                }
            </div>
        </div>
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show">@success<button class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show">@error<button class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>
<footer class="border-top py-4 mt-5 text-center text-secondary small">BiteFlow · Sistema POS y gestión de pedidos</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
