@using BiteFlow.Web.Data
@inject CarritoRepository Carrito
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · BiteFlow</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/biteflow.css" asp-append-version="true" />
</head>
<body>
    @{
        var auth = User.Identity?.IsAuthenticated == true;
        var esCliente = auth && User.IsInRole(Roles.Cliente);
        var esAdmin = auth && User.IsInRole(Roles.Administrador);
        var esCajero = auth && User.IsInRole(Roles.Cajero);
        var esStaff = esAdmin || esCajero;
        var ctrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
        var adminCtrls = new[] { "Productos", "Categorias", "Usuarios", "Reportes" };
        var enAdmin = adminCtrls.Contains(ctrl) || (ctrl == "Home" && (ViewContext.RouteData.Values["action"] as string) == "Admin");
        var cantidadCarrito = 0;
        try { cantidadCarrito = Carrito.Obtener().Sum(x => x.Cantidad); } catch { }
        var rolActual = esAdmin ? Roles.Administrador : esCajero ? Roles.Cajero : esCliente ? Roles.Cliente : "";
    }
    <nav class="navbar navbar-expand-lg bf-nav">
        <div class="container">
            <a class="bf-brand" asp-controller="Home" asp-action="Index">BiteFlow<i class="bi bi-dot"></i></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto ms-lg-4 mt-3 mt-lg-0 gap-1">
                    <li class="nav-item"><a class="nav-link @(ctrl == "Home" && !enAdmin ? "active" : "")" asp-controller="Home" asp-action="Index">Carta</a></li>
                    @if (esCliente)
                    {
                        <li class="nav-item"><a class="nav-link @(ctrl == "Pedidos" ? "active" : "")" asp-controller="Pedidos" asp-action="MisPedidos">Mis pedidos</a></li>
                    }
                    @if (esCajero)
                    {
                        <li class="nav-item"><a class="nav-link @(ctrl == "Pagos" ? "active" : "")" asp-controller="Pagos" asp-action="Index"><i class="bi bi-cash-coin me-1"></i>Caja</a></li>
                    }
                    @if (esAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(enAdmin || ctrl == "Pagos" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                            <ul class="dropdown-menu bf-menu">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Admin"><i class="bi bi-grid me-2"></i>Panel</a></li>
                                <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-egg-fried me-2"></i>Productos</a></li>
                                <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index"><i class="bi bi-tags me-2"></i>Categorías</a></li>
                                <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people me-2"></i>Usuarios</a></li>
                                <li><a class="dropdown-item" asp-controller="Pagos" asp-action="Index"><i class="bi bi-cash-coin me-2"></i>Caja</a></li>
                                <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Index"><i class="bi bi-bar-chart me-2"></i>Reportes</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-lg-0">
                    @if (!esStaff)
                    {
                        <a class="btn btn-brand btn-sm" asp-controller="Carrito" asp-action="Index">
                            <i class="bi bi-bag me-1"></i>Carrito
                            @if (cantidadCarrito > 0) { <span class="cart-count">@cantidadCarrito</span> }
                        </a>
                    }
                    @if (auth)
                    {
                        <span class="text-white small d-none d-lg-inline">@User.Identity!.Name</span>
                        <span class="role-chip">@rolActual</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button class="btn btn-sm btn-outline-light">Salir</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Ingresar</a>
                        <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Register">Crear cuenta</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 py-lg-5">
        @foreach (var key in new[] { "Ok", "Success", "Mensaje" })
        {
            if (TempData[key] is string ok) { <div class="alert alert-success alert-dismissible fade show" role="alert">@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div> }
        }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@err<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div> }
        @RenderBody()
    </main>

    <footer class="bf-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><strong>BiteFlow</strong> · Carta digital y pedidos</span>
            <span>© @DateTime.Now.Year</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
