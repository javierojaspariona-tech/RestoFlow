@model Pedido
@{ ViewData["Title"]="Detalle de pedido"; }
<h1 class="h3 fw-bold">Pedido @Model.Codigo</h1><p class="text-secondary">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm") · @Model.Estado</p>
<div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Importe</th></tr></thead><tbody>@foreach(var d in Model.Detalles){<tr><td>@d.NombreProducto</td><td>@d.Cantidad</td><td>S/ @d.PrecioUnitario.ToString("0.00")</td><td>S/ @((d.Cantidad*d.PrecioUnitario).ToString("0.00"))</td></tr>}</tbody></table></div>
<div class="text-end mt-3"><div>Subtotal: S/ @Model.Subtotal.ToString("0.00")</div><div>IGV incluido: S/ @Model.Igv.ToString("0.00")</div><strong>Total: S/ @Model.Total.ToString("0.00")</strong></div>
