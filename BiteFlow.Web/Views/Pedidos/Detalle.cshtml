@model Pedido
@{ ViewData["Title"] = "Detalle de pedido"; }

<div class="page-head">
    <div>
        <h1 class="page-title">Pedido @Model.Codigo</h1>
        <p class="page-sub">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-estado est-@((Model.Estado ?? "").ToLowerInvariant())">@Model.Estado</span>
</div>

<div class="table-wrap table-responsive">
    <table class="table">
        <thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th class="text-end">Importe</th></tr></thead>
        <tbody>
            @foreach (var d in Model.Detalles)
            {
                <tr>
                    <td class="fw-semibold">@d.NombreProducto</td>
                    <td>@d.Cantidad</td>
                    <td>S/ @d.PrecioUnitario.ToString("0.00")</td>
                    <td class="text-end">S/ @((d.Cantidad * d.PrecioUnitario).ToString("0.00"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row justify-content-end mt-4">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card card-body">
            <div class="d-flex justify-content-between small text-secondary"><span>Subtotal</span><span>S/ @Model.Subtotal.ToString("0.00")</span></div>
            <div class="d-flex justify-content-between small text-secondary mb-2"><span>IGV incluido</span><span>S/ @Model.Igv.ToString("0.00")</span></div>
            <div class="total-box d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Total</span>
                <span class="total-amount">S/ @Model.Total.ToString("0.00")</span>
            </div>
        </div>
    </div>
</div>

<div class="mt-4"><a asp-action="MisPedidos" class="btn btn-line"><i class="bi bi-arrow-left me-1"></i>Volver a mis pedidos</a></div>
