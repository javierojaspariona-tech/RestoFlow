@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5 col-xl-4">
        <div class="card card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="admin-icon mx-auto mb-3"><i class="bi bi-person"></i></span>
                <h1 class="h3 mb-1">Bienvenido</h1>
                <p class="text-secondary mb-0">Ingresa a tu cuenta BiteFlow</p>
            </div>
            <form method="post" novalidate>
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-box mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" autocomplete="username" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label">Recordarme</label>
                </div>
                <button class="btn btn-brand w-100">Iniciar sesión</button>
            </form>
            <p class="text-center small mt-4 mb-0">¿No tienes cuenta? <a asp-action="Register" class="fw-semibold">Regístrate</a></p>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
