@{ ViewData["Title"]="Panel administrativo"; }
<h1 class="h3 fw-bold mb-4">Panel administrativo</h1>
<div class="row g-3">
@foreach(var item in new[]{("Productos","Productos","bi-egg-fried"),("Categorías","Categorias","bi-tags"),("Usuarios","Usuarios","bi-people"),("Caja","Pagos","bi-cash-coin"),("Reportes","Reportes","bi-bar-chart")})
{
<div class="col-md-6 col-xl-4"><a class="card card-body text-decoration-none text-dark h-100" asp-controller="@item.Item2" asp-action="Index"><i class="bi @item.Item3 fs-2 text-warning"></i><h2 class="h5 mt-3">@item.Item1</h2><span class="text-secondary small">Abrir módulo <i class="bi bi-arrow-right"></i></span></a></div>
}
</div>
