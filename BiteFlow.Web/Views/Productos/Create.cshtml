@model ProductoViewModel
@{ ViewData["Title"]="Nuevo producto"; }
<h1 class="h3 fw-bold mb-3">Nuevo producto</h1><div class="card card-body"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control"></textarea></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Precio" class="form-label"></label><input asp-for="Precio" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="IdCategoria" class="form-label">Categoría</label><select asp-for="IdCategoria" class="form-select" asp-items="@(new SelectList((IEnumerable<Categoria>)ViewBag.Categorias,"IdCategoria","Nombre"))"><option value="">Seleccionar</option></select></div></div>
<div class="mb-3"><label asp-for="ImagenUrl" class="form-label">URL de imagen</label><input asp-for="ImagenUrl" class="form-control"/></div><div class="form-check mb-3"><input asp-for="Disponible" class="form-check-input"/><label asp-for="Disponible" class="form-check-label">Disponible en carta</label></div>
<button class="btn btn-warning">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
