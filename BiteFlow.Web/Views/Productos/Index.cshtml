@model IReadOnlyList<Producto>
@{ ViewData["Title"]="Productos"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 fw-bold">Productos</h1><p class="text-secondary mb-0">Administra platos y bebidas de la carta.</p></div><a asp-action="Create" class="btn btn-warning"><i class="bi bi-plus-lg me-1"></i>Nuevo producto</a></div>
<div class="card table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Disponible</th><th>Activo</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td>@p.Nombre</td><td>@p.Categoria?.Nombre</td><td>S/ @p.Precio.ToString("0.00")</td><td>@(p.Disponible?"Sí":"No")</td><td>@(p.Activo?"Sí":"No")</td><td><form asp-action="Eliminar" method="post"><input type="hidden" name="id" value="@p.IdProducto"/><button class="btn btn-sm btn-outline-danger" disabled="@(!p.Activo)">Desactivar</button></form></td></tr>}
</tbody></table></div>
